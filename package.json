{
  "name": "projects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --host 0.0.0.0",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "start": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json",
    "ts-check": "pnpm run typecheck",
    "lint:build": "eslint . --quiet",
    "validate": "pnpm run typecheck && pnpm run lint:build",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "lucide-react": "^0.468.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.43.0",
    "@eslint/js": "9.39.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "only-allow": "^1.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "wrangler": "4.107.0"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "pnpm": ">=9.0.0"
  }
}
